{
  "subscription_mappings": {
    "type": "list",
    "item_type": "string",
    "default": [],
    "description": "订阅分组管理（请使用独立页面）",
    "hint": "请在插件详情页打开“订阅分组管理”页面进行新增、编辑和保存。此字段仅保留为兼容存储，请不要在这里手动修改。"
  },
  "subscription_delivery_options": {"type": "object", "items": {}, "default": {}, "invisible": true},
  "account_settings": {
    "type": "object",
    "description": "微博账号与认证",
    "hint": "配置需要监控的微博账号和访问凭据。",
    "items": {
      "weibo_urls": {"type": "list", "item_type": "string", "default": [], "invisible": true},
      "weibo_cookie": {"type": "string", "default": "", "description": "微博 Cookie", "hint": "微博动态抓取必须配置。填写后还需在插件详情页的“订阅分组管理”中添加接收会话。", "obvious_hint": true},
      "cookie_notification_target": {"type": "string", "default": "", "description": "管理与配置提醒目标", "hint": "可选，填写会话 ID；用于 Cookie 未配置、Cookie 失效或尚未配置订阅分组等管理提醒。未填写时，只有已有订阅会话的提醒可回退发送到这些会话。"}
    }
  },
  "schedule_settings": {
    "type": "object",
    "description": "监控频率",
    "hint": "设置微博检查和账号请求的时间间隔。",
    "items": {
      "check_interval": {"type": "int", "default": 10, "description": "检查间隔（分钟）"},
      "check_interval_jitter": {"type": "int", "default": 2, "description": "检查间隔随机浮动（分钟）", "hint": "实际值会在间隔上下随机浮动。"},
      "request_interval": {"type": "int", "default": 5, "description": "账号请求间隔（秒）"},
      "request_interval_jitter": {"type": "int", "default": 1, "description": "请求间隔随机浮动（秒）"}
    }
  },
  "content_settings": {
    "type": "object",
    "description": "微博推送内容",
    "hint": "设置需要推送的微博类型和消息格式。",
    "items": {
      "message_format": {"type": "string", "default": "🔔 {name} 发微博啦！\n\n{weibo}\n\n链接: {link}", "description": "推送消息格式", "hint": "支持 {name}、{weibo}、{link}。"},
      "send_original": {"type": "bool", "default": true, "description": "推送原创微博"},
      "send_forward": {"type": "bool", "default": true, "description": "推送转发微博"}
    }
  },
  "media_settings": {
    "type": "object",
    "description": "图片与视频",
    "hint": "配置微博媒体文件的下载、发送和清理规则。",
    "items": {
      "enable_image_download": {"type": "bool", "default": true, "description": "下载并推送图片"},
      "max_images_per_post": {"type": "int", "default": 0, "description": "每条微博最多获取图片数", "hint": "0 表示获取所有图片。"},
      "enable_video_download": {"type": "bool", "default": true, "description": "下载并推送视频"},
      "max_video_size_mb": {"type": "int", "default": 0, "description": "最大视频文件大小（MB）", "hint": "0 表示不限制。"},
      "video_download_timeout": {"type": "int", "default": 60, "description": "视频下载超时（秒）", "hint": "0 表示不限制。"},
      "video_send_timeout": {"type": "int", "default": 60, "description": "视频发送超时（秒）", "hint": "0 表示不限制。"},
      "temp_media_retention_minutes": {"type": "int", "default": 10, "description": "临时媒体保留时长（分钟）", "hint": "0 表示不清理。"}
    }
  },
  "filter_settings": {
    "type": "object",
    "description": "内容过滤",
    "hint": "按照微博正文关键词决定是否推送。",
    "items": {
      "filter_keywords": {"type": "list", "item_type": "string", "default": [], "description": "屏蔽词列表"},
      "whitelist_keywords": {"type": "list", "item_type": "string", "default": [], "description": "关键词白名单"}
    }
  },
  "logging_settings": {
    "type": "object",
    "description": "日志与每日总结",
    "hint": "配置运行日志、推送记录和每日统计。",
    "items": {
      "enable_plugin_log": {"type": "bool", "default": true, "description": "开启运行日志"},
      "plugin_log_max_size": {"type": "int", "default": 1, "description": "日志文件最大大小（MB）"},
      "enable_daily_log": {"type": "bool", "default": true, "description": "开启每日推送记录"},
      "enable_daily_summary": {"type": "bool", "default": true, "description": "开启每日发送总结"},
      "daily_summary_time": {"type": "string", "default": "08:00", "description": "每日总结推送时间"}
    }
  },
  "hotsearch_settings": {
    "type": "object",
    "description": "微博热搜",
    "hint": "设置微博热搜榜的获取和推送方式。",
    "items": {
      "enable_hotsearch": {"type": "bool", "default": true, "description": "开启微博热搜监控"},
      "hotsearch_interval": {"type": "int", "default": 60, "description": "热搜推送间隔（分钟）"},
      "hotsearch_top_n": {"type": "int", "default": 10, "description": "推送热搜前 N 条"},
      "hotsearch_filter_ads": {"type": "bool", "default": true, "description": "过滤热搜广告位"},
      "hotsearch_show_link": {"type": "bool", "default": true, "description": "显示热搜条目链接"},
      "hotsearch_message_format": {"type": "string", "default": "🔥 微博热搜榜 Top {top_n}\n⏰ 更新时间: {time}\n\n{items}", "description": "热搜推送消息格式", "hint": "支持 {top_n}、{time}、{items}。"}
    }
  },
  "_config_schema_version": {"type": "int", "default": 0, "invisible": true},
  "weibo_urls": {"type": "list", "item_type": "string", "default": [], "invisible": true},
  "weibo_cookie": {"type": "string", "default": "", "invisible": true},
  "cookie_notification_target": {"type": "string", "default": "", "invisible": true},
  "check_interval": {"type": "int", "default": 10, "invisible": true},
  "check_interval_jitter": {"type": "int", "default": 2, "invisible": true},
  "request_interval": {"type": "int", "default": 5, "invisible": true},
  "request_interval_jitter": {"type": "int", "default": 1, "invisible": true},
  "message_format": {"type": "string", "default": "🔔 {name} 发微博啦！\n\n{weibo}\n\n链接: {link}", "invisible": true},
  "enable_image_download": {"type": "bool", "default": true, "invisible": true},
  "max_images_per_post": {"type": "int", "default": 0, "invisible": true},
  "enable_video_download": {"type": "bool", "default": true, "invisible": true},
  "max_video_size_mb": {"type": "int", "default": 0, "invisible": true},
  "video_download_timeout": {"type": "int", "default": 60, "invisible": true},
  "video_send_timeout": {"type": "int", "default": 60, "invisible": true},
  "temp_media_retention_minutes": {"type": "int", "default": 10, "invisible": true},
  "filter_keywords": {"type": "list", "item_type": "string", "default": [], "invisible": true},
  "whitelist_keywords": {"type": "list", "item_type": "string", "default": [], "invisible": true},
  "send_original": {"type": "bool", "default": true, "invisible": true},
  "send_forward": {"type": "bool", "default": true, "invisible": true},
  "enable_plugin_log": {"type": "bool", "default": true, "invisible": true},
  "plugin_log_max_size": {"type": "int", "default": 1, "invisible": true},
  "enable_daily_log": {"type": "bool", "default": true, "invisible": true},
  "enable_daily_summary": {"type": "bool", "default": true, "invisible": true},
  "daily_summary_time": {"type": "string", "default": "08:00", "invisible": true},
  "enable_hotsearch": {"type": "bool", "default": true, "invisible": true},
  "hotsearch_interval": {"type": "int", "default": 60, "invisible": true},
  "hotsearch_top_n": {"type": "int", "default": 10, "invisible": true},
  "hotsearch_filter_ads": {"type": "bool", "default": true, "invisible": true},
  "hotsearch_show_link": {"type": "bool", "default": true, "invisible": true},
  "hotsearch_message_format": {"type": "string", "default": "🔥 微博热搜榜 Top {top_n}\n⏰ 更新时间: {time}\n\n{items}", "invisible": true},
  "target_conversation_id": {"type": "list", "item_type": "string", "default": [], "invisible": true}
}
